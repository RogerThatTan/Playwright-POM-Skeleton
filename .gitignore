# Dependencies
node_modules/

# Local secrets — never commit (copy from .env.example)
.env
.env.local
.env.*.local

# Auth state — generated by setup/auth/*.auth.setup.ts
/storage/*
!/storage/.gitkeep

# Runtime test artifacts
/test-contexts/*
!/test-contexts/.gitkeep

# Playwright outputs
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
playwright-report.zip
.playwright-mcp/

# PDF / custom report output
/reports/pdf/*
!/reports/pdf/.gitkeep

# TypeScript
*.tsbuildinfo

# Logs & temp
*.log
npm-debug.log*
.cache/
tmp/
temp/
