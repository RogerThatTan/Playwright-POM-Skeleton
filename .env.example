# Copy to .env and adjust. Dummy values only — replace for your app.

BASE_URL=https://example.com

# Example user (used by login page / auth setup)
EXAMPLE_USERNAME=dummy_user
EXAMPLE_PASSWORD=dummy_password

# Optional second user (multi-user fixture)
MULTI_USERNAME=dummy_multi_user
MULTI_PASSWORD=dummy_multi_password

# Playwright
HEADLESS=true
CI=

# Optional reporters / heal (stubs)
PDF_REPORT_ENABLED=false
LOCATOR_HEAL_ENABLED=false
